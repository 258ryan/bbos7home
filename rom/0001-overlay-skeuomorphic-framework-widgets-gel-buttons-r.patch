 .../res/drawable/btn_default_mtrl_shape.xml   | 47 ++++++++++++
 .../drawable/dialog_background_material.xml   | 34 +++++++++
 .../res/res/drawable/edit_text_material.xml   | 42 +++++++++++
 .../drawable/popup_background_material.xml    | 31 ++++++++
 .../drawable/progress_horizontal_material.xml | 66 ++++++++++++++++
 .../res/drawable/seekbar_track_material.xml   | 75 +++++++++++++++++++
 .../res/drawable/switch_track_material.xml    | 42 +++++++++++
 8 files changed, 357 insertions(+)
