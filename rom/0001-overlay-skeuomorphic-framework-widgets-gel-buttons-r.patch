+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_enabled="false" android:color="#55505358" />
+    <item android:state_checked="true" android:color="?android:attr/colorControlActivated" />
+    <item android:color="#FF3A3D42" />
+</selector>
diff --git a/overlay/frameworks/base/core/res/res/drawable/btn_default_mtrl_shape.xml b/overlay/frameworks/base/core/res/res/drawable/btn_default_mtrl_shape.xml
new file mode 100644
index 0000000..5303a3b
--- /dev/null
+++ b/overlay/frameworks/base/core/res/res/drawable/btn_default_mtrl_shape.xml
@@ -0,0 +1,47 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2014 The Android Open Source Project
+
+     Licensed under the Apache License, Version 2.0 (the "License");
+     you may not use this file except in compliance with the License.
+     You may obtain a copy of the License at
+
+          http://www.apache.org/licenses/LICENSE-2.0
+
+     Unless required by applicable law or agreed to in writing, software
+     distributed under the License is distributed on an "AS IS" BASIS,
+     WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+     See the License for the specific language governing permissions and
+     limitations under the License.
+-->
+<!-- Gel button: soft shadow, body tinted with the theme's button colour, glossy upper half, dark outline. -->
+<inset xmlns:android="http://schemas.android.com/apk/res/android"
+    android:insetLeft="4dp" android:insetTop="6dp" android:insetRight="4dp" android:insetBottom="6dp">
+    <layer-list>
+        <item android:top="2dp">
+            <shape android:shape="rectangle">
+                <corners android:radius="7dp" />
+                <solid android:color="#44000000" />
+            </shape>
+        </item>
+        <item android:bottom="2dp">
+            <shape android:shape="rectangle" android:tint="?android:attr/colorButtonNormal">
+                <corners android:radius="7dp" />
+                <solid android:color="@android:color/white" />
+                <padding android:left="16dp" android:top="4dp" android:right="16dp" android:bottom="4dp" />
+            </shape>
+        </item>
+        <item android:bottom="2dp">
+            <shape android:shape="rectangle">
+                <corners android:radius="7dp" />
+                <gradient android:angle="270" android:startColor="#80FFFFFF" android:centerColor="#26FFFFFF"
+                    android:endColor="#14000000" android:centerY="0.5" />
+            </shape>
+        </item>
+        <item android:bottom="2dp">
+            <shape android:shape="rectangle">
+                <corners android:radius="7dp" />
+                <stroke android:width="1dp" android:color="#88000000" />
+            </shape>
+        </item>
+    </layer-list>
+</inset>
diff --git a/overlay/frameworks/base/core/res/res/drawable/dialog_background_material.xml b/overlay/frameworks/base/core/res/res/drawable/dialog_background_material.xml
new file mode 100644
index 0000000..2fbe364
--- /dev/null
+++ b/overlay/frameworks/base/core/res/res/drawable/dialog_background_material.xml
@@ -0,0 +1,34 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2014 The Android Open Source Project
+
+     Licensed under the Apache License, Version 2.0 (the "License");
+     you may not use this file except in compliance with the License.
+     You may obtain a copy of the License at
+
+          http://www.apache.org/licenses/LICENSE-2.0
+
+     Unless required by applicable law or agreed to in writing, software
+     distributed under the License is distributed on an "AS IS" BASIS,
+     WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+     See the License for the specific language governing permissions and
+     limitations under the License.
+-->
+<!-- Dialog: theme background with a glassy sheen on top and a bevelled edge. -->
+<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
+    <layer-list>
+        <item>
+            <shape android:shape="rectangle">
+                <corners android:radius="10dp" />
+                <solid android:color="?android:attr/colorBackground" />
+            </shape>
+        </item>
+        <item>
+            <shape android:shape="rectangle">
+                <corners android:radius="10dp" />
+                <gradient android:angle="270" android:startColor="#33FFFFFF" android:centerColor="#08FFFFFF"
+                    android:endColor="#22000000" android:centerY="0.35" />
+                <stroke android:width="1dp" android:color="#66808890" />
+            </shape>
+        </item>
+    </layer-list>
+</inset>
diff --git a/overlay/frameworks/base/core/res/res/drawable/edit_text_material.xml b/overlay/frameworks/base/core/res/res/drawable/edit_text_material.xml
new file mode 100644
index 0000000..589127d
--- /dev/null
+++ b/overlay/frameworks/base/core/res/res/drawable/edit_text_material.xml
@@ -0,0 +1,42 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2014 The Android Open Source Project
+
+     Licensed under the Apache License, Version 2.0 (the "License");
+     you may not use this file except in compliance with the License.
+     You may obtain a copy of the License at
+
+          http://www.apache.org/licenses/LICENSE-2.0
+
+     Unless required by applicable law or agreed to in writing, software
+     distributed under the License is distributed on an "AS IS" BASIS,
+     WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+     See the License for the specific language governing permissions and
+     limitations under the License.
+-->
+<!-- Text field underline as a pressed-in groove: dark line with a light line below it; blue when focused. -->
+<inset xmlns:android="http://schemas.android.com/apk/res/android"
+    android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="4dp" android:insetBottom="8dp">
+    <selector>
+        <item android:state_enabled="false">
+            <layer-list>
+                <item android:gravity="bottom" android:height="1dp"><shape><solid android:color="#33808890" /></shape></item>
+            </layer-list>
+        </item>
+        <item android:state_pressed="false" android:state_focused="false">
+            <layer-list>
+                <item android:gravity="bottom" android:height="1dp"><shape><solid android:color="#44FFFFFF" /></shape></item>
+                <item android:gravity="bottom" android:height="1dp" android:bottom="1dp"><shape><solid android:color="#99000000" /></shape></item>
+            </layer-list>
+        </item>
+        <item>
+            <layer-list>
+                <item android:gravity="bottom" android:height="3dp">
+                    <shape android:shape="rectangle" android:tint="?android:attr/colorControlActivated">
+                        <corners android:radius="1dp" />
+                        <solid android:color="@android:color/white" />
+                    </shape>
+                </item>
+            </layer-list>
+        </item>
+    </selector>
+</inset>
diff --git a/overlay/frameworks/base/core/res/res/drawable/popup_background_material.xml b/overlay/frameworks/base/core/res/res/drawable/popup_background_material.xml
new file mode 100644
