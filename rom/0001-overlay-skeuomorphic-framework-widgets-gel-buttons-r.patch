diff --git a/overlay/frameworks/base/core/res/res/color/slate_switch_track.xml b/overlay/frameworks/base/core/res/res/color/slate_switch_track.xml
new file mode 100644
index 0000000..6142493
--- /dev/null
+++ b/overlay/frameworks/base/core/res/res/color/slate_switch_track.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 258ryan
+
