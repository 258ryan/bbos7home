<?xml version="1.0" encoding="utf-8"?>
<!-- Recessed groove: coloured fill, dark inner shadow along the top, light lip along the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_vertical|fill_horizontal" android:start="4dp" android:end="4dp">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#40FFFFFF" />
                    <size android:height="15dp" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle" android:tint="@color/slate_switch_track">
                    <corners android:radius="7dp" />
                    <solid android:color="@android:color/white" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <gradient android:angle="270" android:startColor="#88000000" android:endColor="#00000000" />
                    <stroke android:width="1dp" android:color="#66000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>
