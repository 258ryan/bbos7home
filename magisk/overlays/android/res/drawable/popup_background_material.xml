<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="?android:attr/colorBackground" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:centerColor="#08FFFFFF"
                android:endColor="#22000000" android:centerY="0.3" />
            <stroke android:width="1dp" android:color="#66808890" />
        </shape>
    </item>
</layer-list>
