<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: theme background with a glassy sheen on top and a bevelled edge. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <layer-list>
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="?android:attr/colorBackground" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <gradient android:angle="270" android:startColor="#33FFFFFF" android:centerColor="#08FFFFFF"
                    android:endColor="#22000000" android:centerY="0.35" />
                <stroke android:width="1dp" android:color="#66808890" />
            </shape>
        </item>
    </layer-list>
</inset>
